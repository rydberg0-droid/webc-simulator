#!/bin/sh
# 외부 → 사내 단방향 보호: 사내 git(origin) 외의 주소로 push하면 차단한다.
# $2 = push 대상 URL
url="$2"
case "$url" in
  *github.com*|*gitlab.com*|*bitbucket.org*)
    echo "✖ push 차단: 이 저장소는 외부→사내 단방향입니다. 외부 주소로 push할 수 없습니다: $url" >&2
    exit 1 ;;
esac
allowed="$(git config --get webc.internalUrl)"
if [ -n "$allowed" ] && [ "$url" != "$allowed" ]; then
  echo "✖ push 차단: 허용된 사내 git 주소가 아닙니다: $url" >&2
  exit 1
fi
exit 0
